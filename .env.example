# Required for Mimulus Explorer
OPENAI_API_KEY=

# Recommended if the Explorer is internet-accessible
MIMULUS_EXPLORER_TOKEN=

# Optional model overrides
MIMULUS_FAST_MODEL=gpt-6-luna
MIMULUS_DEEP_MODEL=gpt-6-sol

# Optional downstream PolyTranslator bridge
POLYTRANSLATOR_API_KEY=
MIMULUS_BRIDGE_TOKEN=
POLYTRANSLATOR_MAX_CREDITS=5
