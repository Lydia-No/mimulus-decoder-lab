{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/explorer/index.html"
    },
    {
      "source": "/hypercube.html",
      "destination": "/explorer/hypercube.html"
    },
    {
      "source": "/token-cube.js",
      "destination": "/explorer/token-cube.js"
    },
    {
      "source": "/cube-view.js",
      "destination": "/explorer/cube-view.js"
    }
  ],
  "functions": {
    "api/explore.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
